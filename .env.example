# Copy to .env (never commit .env). All values are optional; defaults suit local development.
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                 # true in production for structured logs
CITY=mumbai                    # key of a city profile (see CITY_CONFIG_PATH for others)
# CITY_BBOX=18.80,72.70,19.55,73.30   # optional override of the model-coverage box: min_lat,min_lon,max_lat,max_lon
# CITY_CONFIG_PATH=./cities.json

# SQLite for local dev only. Use PostgreSQL for persistent deployments:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/waterlogging
DATABASE_URL=sqlite:///./data/app.db

# Dataset + model artifacts. MOUNT A PERSISTENT VOLUME HERE IN PRODUCTION.
STORAGE_BACKEND=local
STORAGE_PATH=./storage

MAX_UPLOAD_MB=20
MAX_CSV_ROWS=200000
UPLOAD_RETENTION_HOURS=24
HISTORY_RETENTION_DAYS=90
RATE_LIMIT_PER_MIN=60

# Required in production (the app refuses to start without them):
ADMIN_TOKEN=                   # >= 16 random characters; protects training, activation, history deletion, cleanup
SECRET_KEY=                    # random value; must differ from the built-in default
POSTGRES_PASSWORD=             # docker-compose only
CORS_ALLOWED_ORIGINS=          # comma-separated explicit origins, e.g. https://app.example.com (empty = same-origin only)
ALLOW_SQLITE_IN_PRODUCTION=false
# Weather: Open-Meteo public endpoints need NO key. Only set a key if you use Open-Meteo's commercial customer API
# (and then also set the WEATHER_*_URL values to customer-api.open-meteo.com); it is never sent to other hosts.
OPEN_METEO_API_KEY=
# WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# WEATHER_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_GEOCODING_COUNTRY=IN
WEATHER_TIMEOUT_S=8
WEATHER_MAX_RETRIES=2
WEATHER_CACHE_TTL_S=600
